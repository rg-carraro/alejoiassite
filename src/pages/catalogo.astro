---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import {listProducts} from '../server/view-store';
const products=await listProducts();
import {categories,collections} from '../data/categories';
---
<BaseLayout title="Coleção"><section class="section catalogue"><p class="eyebrow">ESCOLHAS QUE COMBINAM COM VOCÊ</p><h1>Nossa coleção</h1><p>Explore, descubra e escolha os seus detalhes favoritos.</p>
<form class="filters" id="filters" role="search"><label>Buscar peça<input type="search" name="busca" placeholder="O que você procura?"/></label><label>Categoria<select name="categoria"><option value="">Todas as categorias</option>{categories.map(c=><option value={c.slug}>{c.name}</option>)}</select></label><label>Coleção<select name="colecao"><option value="">Todas as coleções</option>{collections.map(c=><option value={c.slug}>{c.name}</option>)}</select></label><label>Ordenar<select name="ordem"><option value="">Seleção Ale Carraro</option><option value="nome">Nome: A–Z</option></select></label><button class="text-link" type="reset">Limpar filtros</button></form>
<p id="result-count" role="status">{products.length} peças</p><div class="product-grid" id="catalog-grid">{products.map(p=><ProductCard product={p}/>)}</div><div class="empty" id="no-results" hidden><h2>Essa seleção ainda está chegando.</h2><p>Não há peças para esses filtros. Explore as outras categorias.</p><button class="button" id="clear-filters">Ver todas as peças</button></div></section></BaseLayout>
